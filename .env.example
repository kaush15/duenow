# PayPal REST App Client ID from developer.paypal.com dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal REST App Client Secret from developer.paypal.com dashboard
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Webhook ID created for /webhooks/paypal in developer dashboard
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Local testing only. Never enable in production.
ALLOW_UNSIGNED_WEBHOOKS=false

# PayPal environment mode: sandbox or live
PAYPAL_MODE=sandbox

# PayPal sandbox merchant/business email for sending invoices
PAYPAL_BUSINESS_EMAIL=your_paypal_business_email@example.com

# LLM provider for AI features: gemini or openai
LLM_PROVIDER=gemini

# API key for the chosen LLM provider (Gemini or OpenAI)
LLM_API_KEY=your_llm_api_key_here

# Model name for LLM (e.g. gemini-3.5-flash, gpt-4o-mini)
LLM_MODEL=gemini-3.5-flash

# Base URL where DueNow is hosted (used for webhooks and callback links)
APP_BASE_URL=http://localhost:8000

# Port for the web server to listen on
PORT=8000
